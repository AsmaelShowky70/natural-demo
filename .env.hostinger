# =====================================================================
# Natural Snacks Traceability - Hostinger Production Configuration
# انسخ هذا الملف باسم .env عند الرفع على استضافة Hostinger
# =====================================================================

APP_NAME="Natural Snacks Traceability"
APP_ENV=production
APP_KEY=base64:h5F2fyiTcPT0I1XLy/oEjmACbLjp+/bHK/8awq5B5qQ=
APP_DEBUG=false
APP_TIMEZONE=Asia/Riyadh
APP_URL=https://your-domain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── إعدادات قاعدة بيانات MySQL على Hostinger ──────────────────────────
# ضع اسم قاعدة البيانات والمستخدم وكلمة المرور المنشأة في لوحة Hostinger (hPanel / MySQL Databases)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_snacks
DB_USERNAME=u123456789_admin
DB_PASSWORD=Your_Strong_Hostinger_Password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@your-domain.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"
